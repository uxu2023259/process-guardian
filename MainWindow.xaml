<Window x:Class="ProcessGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="进程守护器" Width="820" Height="690" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4"
        FontFamily="Segoe UI, Microsoft YaHei UI" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="42"/>
      <Setter Property="Height" Value="40"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="40"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#111111">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
          <Border Width="22" Height="22" CornerRadius="6" Background="White">
            <TextBlock Text="P" Foreground="#111111" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="进程守护器" Foreground="White" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
          <TextBlock x:Name="AppVersion" Foreground="#777777" FontSize="10"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                  Content="□" Click="MaximizeRestore_Click"/>
          <Button Style="{StaticResource WindowButton}" Content="×" FontSize="19" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="24,18,24,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel LastChildFill="False" Margin="1,0,1,12">
        <StackPanel>
          <TextBlock Text="程序列表" FontSize="21" FontWeight="Bold" Foreground="#111111"/>
          <TextBlock Text="查看运行状态，管理自动恢复。" FontSize="11" Foreground="#777777"
                     Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="AddProgramButton" DockPanel.Dock="Right" Content="＋  添加程序" Style="{StaticResource PrimaryButton}"
                MinWidth="126" Padding="14,9" VerticalAlignment="Center"
                Click="AddProgram_Click" IsDefault="True"/>
      </DockPanel>

      <Grid Grid.Row="1">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProgramCount}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <ItemsControl ItemsSource="{Binding Programs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" CornerRadius="10" BorderBrush="#E6E6E6"
                        BorderThickness="1" Padding="12,9" Margin="0,0,0,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Border Width="28" Height="28" CornerRadius="8" Background="#F1F1F1"
                            VerticalAlignment="Center">
                      <TextBlock Text="◇" FontSize="17" Foreground="#222222"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,12,0">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                 Foreground="#141414" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#888888"
                                 Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="#777777"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                      <TextBlock Text="{Binding StateGlyph}" FontSize="10" Foreground="#222222"
                                 Margin="0,0,5,0" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="#333333" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding RestartCountText}" FontSize="9" Foreground="#888888"
                                 Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding ToggleText}" Style="{StaticResource QuietButton}"
                              Padding="10,7" Margin="0,0,6,0" Command="{Binding ToggleCommand}"/>
                      <Button Content="重启" Style="{StaticResource QuietButton}"
                              Padding="10,7" Margin="0,0,6,0" Command="{Binding RestartCommand}"/>
                      <Button Content="移除" Style="{StaticResource QuietButton}"
                              Padding="10,7" Command="{Binding RemoveCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
        <Border Background="White" CornerRadius="11" BorderBrush="#E6E6E6" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProgramCount}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="列表还是空的" FontSize="14" FontWeight="Bold"
                       Foreground="#202020" HorizontalAlignment="Center"/>
            <TextBlock Text="点击右上角“添加程序”开始守护。" FontSize="11" Foreground="#888888"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
