<Window x:Class="ProcessGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="进程守护器" Width="1160" Height="740" MinWidth="960" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#F5F5F5" FontFamily="Segoe UI, Microsoft YaHei UI"
        WindowStyle="None" ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="42" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" Background="#101010">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="15,0,0,0">
          <Border Width="23" Height="23" CornerRadius="6" Background="White">
            <TextBlock Text="P" Foreground="#111111" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="进程守护器" Foreground="White" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
          <TextBlock x:Name="AppVersion" Text="" Foreground="#777777" FontSize="10" VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Width="46" Height="42" Content="—" Click="Minimize_Click" Background="Transparent"
                  Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button x:Name="MaximizeButton" Width="46" Height="42" Content="□" Click="MaximizeRestore_Click"
                  Background="Transparent" Foreground="White" BorderThickness="0" FontSize="14" Cursor="Hand"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
          <Button Width="46" Height="42" Content="×" Click="Close_Click" Background="Transparent"
                  Foreground="White" BorderThickness="0" FontSize="19" Cursor="Hand"
                  shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
        </StackPanel>
      </DockPanel>
    </Border>
    <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="246"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <Border Grid.Column="0" Background="#101010">
      <Grid Margin="22,26,20,22">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="5,3,0,0">
          <Border Width="35" Height="35" CornerRadius="10" Background="White" VerticalAlignment="Center">
            <TextBlock Text="P" Foreground="#111111" FontSize="19" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0"/>
          </Border>
          <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="GUARD" Foreground="White" FontSize="15" FontWeight="Bold"/>
            <TextBlock Text="进程守护器" Foreground="#A3A3A3" FontSize="11" Margin="0,2,0,0"/>
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,64,0,0">
          <TextBlock Text="工作区" Foreground="#777777" FontSize="10" FontWeight="Bold" Margin="12,0,0,14"/>
          <Border Background="#282828" CornerRadius="9" Padding="12,12" Margin="0,0,0,7">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock Text="◈" FontSize="17" Foreground="White" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="程序守护" Foreground="White" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Margin="7,0,0,0"/>
              <Border Grid.Column="2" Background="#444444" CornerRadius="6" Padding="7,3" VerticalAlignment="Center">
                <TextBlock Text="{Binding ProgramCount}" Foreground="White" FontSize="11" FontWeight="Bold"/>
              </Border>
            </Grid>
          </Border>
          <TextBlock Text="实时事件" Foreground="#B5B5B5" FontSize="12" Margin="13,13,0,0"/>
        </StackPanel>

        <StackPanel Grid.Row="2">
          <Border Height="1" Background="#303030" Margin="0,0,0,17"/>
          <StackPanel Orientation="Horizontal" Margin="5,0,0,0">
            <Border Width="30" Height="30" CornerRadius="15" Background="#2D2D2D">
              <TextBlock Text="PG" Foreground="White" FontSize="10" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
              <TextBlock Text="本机守护会话" Foreground="#E8E8E8" FontSize="12" FontWeight="SemiBold"/>
              <TextBlock Text="登录后自动恢复" Foreground="#777777" FontSize="10" Margin="0,3,0,0"/>
            </StackPanel>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" Margin="35,29,35,28">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Grid>
        <StackPanel>
          <TextBlock Text="系统总览" FontSize="27" FontWeight="Bold" Foreground="#111111"/>
          <TextBlock Text="查看程序健康状态并管理自动恢复" FontSize="13" Foreground="#777777" Margin="0,6,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Margin="0,0,14,0" VerticalAlignment="Center">
            <TextBlock Text="登录时启动" FontSize="12" FontWeight="SemiBold" Foreground="#222222" HorizontalAlignment="Right"/>
            <TextBlock Text="在后台继续守护" FontSize="10" Foreground="#888888" HorizontalAlignment="Right" Margin="0,3,0,0"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" VerticalAlignment="Center" Cursor="Hand"/>
          <Border Width="1" Height="30" Background="#DDDDDD" Margin="18,0"/>
          <Button Content="＋  添加程序" Style="{StaticResource PrimaryButton}" Command="{Binding AddProgramCommand}"/>
        </StackPanel>
      </Grid>

      <UniformGrid Grid.Row="1" Columns="4" Margin="0,25,0,23">
        <Border Background="White" CornerRadius="12" Padding="18,17" Margin="0,0,12,0" BorderBrush="#E9E9E9" BorderThickness="1">
          <StackPanel><TextBlock Text="受管程序" FontSize="11" Foreground="#777777"/><TextBlock Text="{Binding ProgramCount}" FontSize="27" FontWeight="Bold" Foreground="#111111" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="White" CornerRadius="12" Padding="18,17" Margin="0,0,12,0" BorderBrush="#E9E9E9" BorderThickness="1">
          <StackPanel><TextBlock Text="正在运行" FontSize="11" Foreground="#777777"/><TextBlock Text="{Binding RunningCount}" FontSize="27" FontWeight="Bold" Foreground="#111111" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="White" CornerRadius="12" Padding="18,17" Margin="0,0,12,0" BorderBrush="#E9E9E9" BorderThickness="1">
          <StackPanel><TextBlock Text="自动恢复" FontSize="11" Foreground="#777777"/><TextBlock Text="{Binding RestartCount}" FontSize="27" FontWeight="Bold" Foreground="#111111" Margin="0,6,0,0"/></StackPanel>
        </Border>
        <Border Background="White" CornerRadius="12" Padding="18,17" BorderBrush="#E9E9E9" BorderThickness="1">
          <StackPanel><TextBlock Text="故障暂停" FontSize="11" Foreground="#777777"/><TextBlock Text="{Binding PausedCount}" FontSize="27" FontWeight="Bold" Foreground="#111111" Margin="0,6,0,0"/></StackPanel>
        </Border>
      </UniformGrid>

      <Grid Grid.Row="2">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
        <Grid Grid.Column="0" Margin="0,0,22,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <DockPanel Margin="1,0,0,14">
            <TextBlock Text="守护列表" FontSize="16" FontWeight="Bold" Foreground="#151515" VerticalAlignment="Center"/>
            <TextBlock Text="{Binding HeaderStatus}" Foreground="#777777" FontSize="11" VerticalAlignment="Center" Margin="12,2,0,0"/>
            <TextBlock Text="运行状态 · 最近事件" Foreground="#999999" FontSize="10" HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
          </DockPanel>
          <Grid Grid.Row="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <ScrollViewer.Style>
                <Style TargetType="ScrollViewer">
                  <Setter Property="Visibility" Value="Visible"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ProgramCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </ScrollViewer.Style>
              <ItemsControl ItemsSource="{Binding Programs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" CornerRadius="13" BorderBrush="#E7E7E7" BorderThickness="1" Padding="19,17" Margin="0,0,0,12">
                    <Grid>
                      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                      <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="45"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <Border Width="39" Height="39" Background="#F1F1F1" CornerRadius="10">
                          <TextBlock Text="◇" FontSize="21" Foreground="#222222" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="11,0,10,0">
                          <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="#141414" TextTrimming="CharacterEllipsis"/>
                          <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#888888" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="12" Padding="10,6" VerticalAlignment="Center">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding StateGlyph}" FontSize="10" Foreground="#222222" Margin="0,0,5,0" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="#333333" VerticalAlignment="Center"/>
                          </StackPanel>
                        </Border>
                      </Grid>
                      <Grid Grid.Row="1" Margin="55,14,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="11" Foreground="#666666" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding RestartCountText}" FontSize="10" Foreground="#888888" VerticalAlignment="Center" Margin="12,0,0,0"/>
                      </Grid>
                      <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="{Binding ToggleText}" Style="{StaticResource QuietButton}" Padding="13,7" Margin="0,0,7,0" Command="{Binding ToggleCommand}"/>
                        <Button Content="重启" Style="{StaticResource QuietButton}" Padding="13,7" Margin="0,0,7,0" Command="{Binding RestartCommand}"/>
                        <Button Content="编辑" Style="{StaticResource QuietButton}" Padding="13,7" Margin="0,0,7,0" Command="{Binding EditCommand}"/>
                        <Button Content="移除" Style="{StaticResource QuietButton}" Padding="13,7" Command="{Binding RemoveCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
            <Border Background="White" CornerRadius="13" BorderBrush="#E7E7E7" BorderThickness="1">
              <Border.Style>
                <Style TargetType="Border">
                  <Setter Property="Visibility" Value="Collapsed"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding ProgramCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="25">
                <Border Width="55" Height="55" CornerRadius="16" Background="#111111" HorizontalAlignment="Center">
                  <TextBlock Text="+" Foreground="White" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-3,0,0"/>
                </Border>
                <TextBlock Text="尚未添加守护程序" FontSize="16" FontWeight="Bold" Foreground="#171717" HorizontalAlignment="Center" Margin="0,17,0,0"/>
                <TextBlock Text="添加一个程序后，守护器会在退出或崩溃时自动恢复。" FontSize="11" Foreground="#888888" TextWrapping="Wrap" TextAlignment="Center" Margin="0,7,0,17"/>
                <Button Content="添加第一个程序" Style="{StaticResource PrimaryButton}" Command="{Binding AddProgramCommand}" HorizontalAlignment="Center"/>
              </StackPanel>
            </Border>
          </Grid>
        </Grid>

        <Border Grid.Column="1" Background="White" CornerRadius="13" BorderBrush="#E7E7E7" BorderThickness="1" Padding="18,18,16,14">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel>
              <Border Width="30" Height="30" Background="#F1F1F1" CornerRadius="9" DockPanel.Dock="Left">
                <TextBlock Text="↻" FontSize="17" Foreground="#222222" HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
              <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="实时活动" FontSize="14" FontWeight="Bold" Foreground="#151515"/>
                <TextBlock Text="崩溃恢复与状态变化" FontSize="10" Foreground="#888888" Margin="0,3,0,0"/>
              </StackPanel>
            </DockPanel>
            <Border Grid.Row="1" Height="1" Background="#EEEEEE" Margin="0,17,0,5"/>
            <Grid Grid.Row="2">
              <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ScrollViewer.Style>
                  <Style TargetType="ScrollViewer">
                    <Setter Property="Visibility" Value="Visible"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </ScrollViewer.Style>
                <ItemsControl ItemsSource="{Binding RecentActivity}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid Margin="0,10,0,5">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="17"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                      <StackPanel HorizontalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="#222222" Margin="0,5,0,0"/>
                        <Border Width="1" Height="34" Background="#E5E5E5" Margin="0,3,0,0"/>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Margin="5,0,0,0">
                        <TextBlock Text="{Binding ProgramName}" FontSize="10" FontWeight="Bold" Foreground="#333333" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Message}" FontSize="10" Foreground="#777777" TextWrapping="Wrap" Margin="0,3,0,0"/>
                        <TextBlock Text="{Binding Timestamp, StringFormat='{}{0:HH:mm:ss}'}" FontSize="9" Foreground="#AAAAAA" Margin="0,4,0,0"/>
                      </StackPanel>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
              <TextBlock Text="暂无事件，运行状态和恢复记录会显示在这里。" Foreground="#999999" FontSize="10"
                         TextAlignment="Center" TextWrapping="Wrap" VerticalAlignment="Center" Margin="12,0">
                <TextBlock.Style>
                  <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding RecentActivity.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                    </Style.Triggers>
                  </Style>
                </TextBlock.Style>
              </TextBlock>
            </Grid>
            <Border Grid.Row="3" Background="#F7F7F7" CornerRadius="8" Padding="11,10" Margin="0,8,0,0">
              <TextBlock Text="连续失败 5 次后将自动暂停，避免程序反复启动。" FontSize="10" Foreground="#666666" TextWrapping="Wrap"/>
            </Border>
          </Grid>
        </Border>
      </Grid>
    </Grid>
    </Grid>
  </Grid>
</Window>
