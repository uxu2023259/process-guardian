<Window x:Class="ProcessGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:ProcessGuardian.Controls"
        xmlns:ui="clr-namespace:ProcessGuardian"
        Title="进程守护器" Width="820" Height="690" MinWidth="760" MinHeight="560"
        WindowStartupLocation="CenterScreen" Background="#F3F3F3"
        FontFamily="Segoe UI, Microsoft YaHei UI" WindowStyle="SingleBorderWindow"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" SnapsToDevicePixels="True"
        PreviewKeyDown="MainWindow_PreviewKeyDown">
  <Grid>
    <Grid Margin="24,20,24,20">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <DockPanel LastChildFill="False" Margin="1,0,1,14">
        <StackPanel>
          <TextBlock Text="进程守护器" FontSize="21" FontWeight="SemiBold" Foreground="#1F1F1F"/>
          <TextBlock Text="受保护的程序 · 查看运行状态并管理自动恢复。" FontSize="11" Foreground="#605E5C"
                     Margin="0,4,0,0"/>
        </StackPanel>
        <Button x:Name="AddProgramButton" DockPanel.Dock="Right" Content="＋  添加程序" Style="{StaticResource PrimaryButton}"
                MinWidth="126" Padding="14,9" VerticalAlignment="Center"
                Click="AddProgram_Click" IsDefault="True"/>
      </DockPanel>

      <Border Grid.Row="1" Background="White" BorderBrush="#D1D1D1" BorderThickness="1"
              Padding="12,9" Margin="0,0,0,12">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding KeepAwakeEnabled, Mode=TwoWay}" VerticalAlignment="Center"
                    Margin="0,0,12,0" FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F">
            <TextBlock Text="防睡眠与自动锁定"/>
          </CheckBox>
          <StackPanel Grid.Column="1" VerticalAlignment="Center">
            <TextBlock Text="保持系统和屏幕唤醒，暂停屏幕保护程序自动锁定，减少锁屏后待机断网。"
                       FontSize="10" Foreground="#1F1F1F" TextWrapping="Wrap"/>
            <TextBlock Text="手动锁屏或组织策略仍可锁定；持续亮屏会增加耗电。" FontSize="9"
                       Foreground="#605E5C" Margin="0,3,0,0" TextWrapping="Wrap"/>
            <TextBlock Text="{Binding KeepAwakeStatus}" FontSize="9" Foreground="#605E5C"
                       Margin="0,3,0,0" TextWrapping="Wrap"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ScrollViewer.Style>
            <Style TargetType="ScrollViewer">
              <Setter Property="Visibility" Value="Visible"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProgramCount}" Value="0">
                  <Setter Property="Visibility" Value="Collapsed"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </ScrollViewer.Style>
          <ItemsControl ItemsSource="{Binding Programs}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Background="White" BorderBrush="#D1D1D1"
                        BorderThickness="1" Padding="12,9" Margin="0,0,0,7">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="34"/>
                      <ColumnDefinition Width="*"/>
                      <ColumnDefinition Width="Auto"/>
                      <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="{Binding ProgramIcon}" Width="28" Height="28"
                           VerticalAlignment="Center" Stretch="Uniform"/>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,12,0">
                      <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                 Foreground="#1F1F1F" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#605E5C"
                                 Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                      <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="#605E5C"
                                 Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                Margin="0,0,12,0">
                      <Grid Width="20" Height="20" Margin="0,0,5,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StateGlyph}" FontSize="10" Foreground="{Binding StateBrush}"
                                   VerticalAlignment="Center">
                          <TextBlock.Style>
                            <Style TargetType="TextBlock">
                              <Setter Property="Visibility" Value="Visible"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </TextBlock.Style>
                        </TextBlock>
                        <controls:ProgressRing x:Name="BusyIndicator">
                          <controls:ProgressRing.Style>
                            <Style TargetType="controls:ProgressRing">
                              <Setter Property="Visibility" Value="Collapsed"/>
                              <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                  <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                              </Style.Triggers>
                            </Style>
                          </controls:ProgressRing.Style>
                        </controls:ProgressRing>
                      </Grid>
                      <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold"
                                 Foreground="{Binding StateBrush}" VerticalAlignment="Center"/>
                      <TextBlock Text="{Binding RestartCountText}" FontSize="9" Foreground="#605E5C"
                                 Margin="10,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                      <Button Content="{Binding ToggleText}" Style="{StaticResource QuietButton}"
                              Padding="10,7" Margin="0,0,6,0" Command="{Binding ToggleCommand}"/>
                      <Button Content="重启" Style="{StaticResource QuietButton}"
                              Padding="10,7" Margin="0,0,6,0" Command="{Binding RestartCommand}"/>
                      <Button Content="移除" Style="{StaticResource QuietButton}"
                              Padding="10,7" Command="{Binding RemoveCommand}"/>
                    </StackPanel>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
          <Border Background="White" BorderBrush="#D1D1D1" BorderThickness="1">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Visibility" Value="Collapsed"/>
              <Style.Triggers>
                <DataTrigger Binding="{Binding ProgramCount}" Value="0">
                  <Setter Property="Visibility" Value="Visible"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
            <TextBlock Text="暂时没有受保护的程序" FontSize="14" FontWeight="SemiBold"
                       Foreground="#1F1F1F" HorizontalAlignment="Center"/>
            <TextBlock Text="选择“添加程序”来创建一个守护项目。" FontSize="11" Foreground="#605E5C"
                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
          </StackPanel>
        </Border>
      </Grid>
    </Grid>

    <Grid x:Name="AddProgramOverlay" Panel.ZIndex="10" Visibility="Collapsed"
          Background="#66000000" Opacity="0">
      <Border x:Name="PopupCard" Width="560" MaxHeight="600" Background="White"
              BorderBrush="#8A8886" BorderThickness="1" HorizontalAlignment="Center"
              VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Opacity="0">
        <Border.RenderTransform>
          <TranslateTransform X="0" Y="10"/>
        </Border.RenderTransform>
        <ScrollViewer MaxHeight="598" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
          <ui:AddProgramPanel x:Name="AddPanel"/>
        </ScrollViewer>
      </Border>
    </Grid>
  </Grid>
</Window>
