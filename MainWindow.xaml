<Window x:Class="ProcessGuardian.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="进程守护器" Width="1080" Height="780" MinWidth="900" MinHeight="660"
        WindowStartupLocation="CenterScreen" Background="#F4F4F4"
        FontFamily="Segoe UI, Microsoft YaHei UI" WindowStyle="None"
        ResizeMode="CanResizeWithGrip" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <shell:WindowChrome.WindowChrome>
    <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0"
                        CornerRadius="0" UseAeroCaptionButtons="False"/>
  </shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#303030"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#DDDDDD"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="MinHeight" Value="40"/>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="44"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
    </Style>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="44"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#111111">
      <DockPanel LastChildFill="False">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
          <Border Width="23" Height="23" CornerRadius="6" Background="White">
            <TextBlock Text="P" Foreground="#111111" FontSize="13" FontWeight="Bold"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <TextBlock Text="进程守护器" Foreground="White" FontSize="12" FontWeight="SemiBold"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
          <TextBlock x:Name="AppVersion" Foreground="#777777" FontSize="10"
                     VerticalAlignment="Center" Margin="9,0,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Style="{StaticResource WindowButton}" Content="—" Click="Minimize_Click"/>
          <Button x:Name="MaximizeButton" Style="{StaticResource WindowButton}"
                  Content="□" Click="MaximizeRestore_Click"/>
          <Button Style="{StaticResource WindowButton}" Content="×" FontSize="19" Click="Close_Click"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Row="1" Margin="34,26,34,24">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <Grid Margin="1,0,1,20">
        <StackPanel>
          <TextBlock Text="添加程序" FontSize="25" FontWeight="Bold" Foreground="#111111"/>
          <TextBlock Text="选择需要守护的程序，退出或崩溃后自动恢复。"
                     FontSize="12" Foreground="#777777" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
          <StackPanel Margin="0,0,9,0" VerticalAlignment="Center">
            <TextBlock Text="登录时启动" FontSize="11" FontWeight="SemiBold" Foreground="#222222"/>
            <TextBlock Text="后台持续守护" FontSize="10" Foreground="#888888" Margin="0,3,0,0"/>
          </StackPanel>
          <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}"
                    VerticalAlignment="Center" Cursor="Hand"/>
        </StackPanel>
      </Grid>

      <Border Grid.Row="1" Background="White" CornerRadius="14" BorderBrush="#E5E5E5"
              BorderThickness="1" Padding="22,19" Margin="0,0,0,22">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
          </Grid.RowDefinitions>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="22"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <StackPanel Grid.Row="0" Grid.Column="0">
            <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>
          </StackPanel>
          <StackPanel Grid.Row="0" Grid.Column="2">
            <TextBlock Text="程序文件" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="选择文件" Style="{StaticResource QuietButton}"
                      Padding="13,10" Click="BrowseExecutable_Click"/>
            </Grid>
          </StackPanel>

          <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,13,0,0">
            <TextBlock Text="启动参数（可选）" Style="{StaticResource FieldLabel}"/>
            <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}"/>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,13,0,0">
            <TextBlock Text="工作目录（可选）" Style="{StaticResource FieldLabel}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="WorkingDirectoryBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
              <Button Grid.Column="1" Content="选择目录" Style="{StaticResource QuietButton}"
                      Padding="13,10" Click="BrowseDirectory_Click"/>
            </Grid>
          </StackPanel>

          <Grid Grid.Row="2" Grid.ColumnSpan="3" Margin="0,13,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
              <CheckBox x:Name="EnabledBox" Content="添加后立即启动并持续守护" IsChecked="True"
                        Foreground="#222222" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,8"/>
              <CheckBox x:Name="AttachExistingBox" Content="程序已运行时接管现有进程，不重复启动"
                        Foreground="#555555" FontSize="11"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Center">
              <TextBlock x:Name="FormMessage" Foreground="#555555" FontSize="11"
                         VerticalAlignment="Center" Margin="0,0,14,0" TextTrimming="CharacterEllipsis"/>
              <Button x:Name="AddButton" Content="添加程序" Style="{StaticResource PrimaryButton}"
                      MinWidth="142" Padding="17,11" Click="Add_Click" IsDefault="True"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Border>

      <Grid Grid.Row="2">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel Margin="1,0,1,11">
          <TextBlock Text="守护列表" FontSize="15" FontWeight="Bold" Foreground="#151515"/>
          <Border Background="#E8E8E8" CornerRadius="9" Padding="8,3" Margin="9,0,0,0">
            <TextBlock Text="{Binding ProgramCount}" FontSize="10" FontWeight="Bold" Foreground="#333333"/>
          </Border>
          <TextBlock Text="运行状态与操作" Foreground="#999999" FontSize="10"
                     HorizontalAlignment="Right" DockPanel.Dock="Right" VerticalAlignment="Center"/>
        </DockPanel>
        <Grid Grid.Row="1">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <ScrollViewer.Style>
              <Style TargetType="ScrollViewer">
                <Setter Property="Visibility" Value="Visible"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ProgramCount}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </ScrollViewer.Style>
            <ItemsControl ItemsSource="{Binding Programs}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="White" CornerRadius="11" BorderBrush="#E6E6E6"
                          BorderThickness="1" Padding="14,12" Margin="0,0,0,9">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="34"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                      </Grid.ColumnDefinitions>
                      <Border Width="28" Height="28" CornerRadius="8" Background="#F1F1F1"
                              VerticalAlignment="Center">
                        <TextBlock Text="◇" FontSize="17" Foreground="#222222"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,12,0">
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold"
                                   Foreground="#141414" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding ExecutablePath}" FontSize="10" Foreground="#888888"
                                   Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding StatusDetail}" FontSize="9" Foreground="#777777"
                                   Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center"
                                  Margin="0,0,12,0">
                        <TextBlock Text="{Binding StateGlyph}" FontSize="10" Foreground="#222222"
                                   Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold"
                                   Foreground="#333333" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding RestartCountText}" FontSize="9" Foreground="#888888"
                                   Margin="10,0,0,0" VerticalAlignment="Center"/>
                      </StackPanel>
                      <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding ToggleText}" Style="{StaticResource QuietButton}"
                                Padding="10,7" Margin="0,0,6,0" Command="{Binding ToggleCommand}"/>
                        <Button Content="重启" Style="{StaticResource QuietButton}"
                                Padding="10,7" Margin="0,0,6,0" Command="{Binding RestartCommand}"/>
                        <Button Content="移除" Style="{StaticResource QuietButton}"
                                Padding="10,7" Command="{Binding RemoveCommand}"/>
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>
          <Border Background="White" CornerRadius="11" BorderBrush="#E6E6E6" BorderThickness="1">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Visibility" Value="Collapsed"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ProgramCount}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="20">
              <TextBlock Text="还没有添加程序" FontSize="14" FontWeight="Bold"
                         Foreground="#202020" HorizontalAlignment="Center"/>
              <TextBlock Text="填写上方信息并添加，程序退出后守护器会自动恢复。"
                         FontSize="11" Foreground="#888888" TextAlignment="Center"
                         TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
