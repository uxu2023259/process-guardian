<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>ProcessGuardian</AssemblyName>
    <RootNamespace>ProcessGuardian</RootNamespace>
    <Version>0.1.31</Version>
    <FileVersion>0.1.31.0</FileVersion>
    <InformationalVersion>0.1.31</InformationalVersion>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <!-- WPF uses PerMonitorV2 from app.manifest; WinForms is limited to tray and folder-picker APIs. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="tests/**/*.cs" />
    <Compile Remove="tools/**/*.cs" />
  </ItemGroup>
</Project>
