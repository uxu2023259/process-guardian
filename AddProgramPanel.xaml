<UserControl x:Class="ProcessGuardian.AddProgramPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
  <UserControl.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#323130"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Background" Value="White"/>
      <Setter Property="Foreground" Value="#1F1F1F"/>
      <Setter Property="BorderBrush" Value="#8A8886"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="10,8"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="MinHeight" Value="36"/>
    </Style>
  </UserControl.Resources>
  <Grid Background="White" Margin="24,20,24,18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <DockPanel LastChildFill="False" Margin="0,0,0,18">
      <Button DockPanel.Dock="Right" Content="×" Style="{StaticResource QuietButton}"
              Padding="8,2" FontSize="17" Click="Cancel_Click"/>
      <StackPanel>
        <TextBlock Text="添加到守护列表" FontSize="20" FontWeight="SemiBold" Foreground="#1F1F1F"/>
        <TextBlock Text="程序退出或崩溃后，守护器会自动恢复。"
                   FontSize="11" Foreground="#605E5C" Margin="0,4,0,0"/>
      </StackPanel>
    </DockPanel>

    <StackPanel Grid.Row="1" Margin="0,0,0,12">
      <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>
    </StackPanel>

    <StackPanel Grid.Row="2" Margin="0,0,0,12">
      <TextBlock Text="程序文件" Style="{StaticResource FieldLabel}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource QuietButton}"
                Padding="12,8" Click="BrowseExecutable_Click"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="3" Margin="0,0,0,12">
      <TextBlock Text="启动参数（可选）" Style="{StaticResource FieldLabel}"/>
      <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}"/>
    </StackPanel>

    <StackPanel Grid.Row="4" Margin="0,0,0,12">
      <TextBlock Text="工作目录（可选）" Style="{StaticResource FieldLabel}"/>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="WorkingDirectoryBox" Style="{StaticResource FieldBox}" Margin="0,0,8,0"/>
        <Button Grid.Column="1" Content="浏览…" Style="{StaticResource QuietButton}"
                Padding="12,8" Click="BrowseDirectory_Click"/>
      </Grid>
    </StackPanel>

    <StackPanel Grid.Row="5" VerticalAlignment="Top" Margin="0,1,0,0">
      <CheckBox x:Name="EnabledBox" Content="添加后立即启动并持续守护" IsChecked="True"
                Foreground="#323130" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,9"/>
      <CheckBox x:Name="AttachExistingBox" Content="程序已运行时接管现有进程，不重复启动"
                Foreground="#605E5C" FontSize="11"/>
      <TextBlock x:Name="FormMessage" Foreground="#A4262C" FontSize="11"
                 TextWrapping="Wrap" Margin="0,13,0,0"/>
    </StackPanel>

    <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="取消" Style="{StaticResource QuietButton}" Padding="16,8"
              Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button x:Name="AddButton" Content="添加程序" Style="{StaticResource PrimaryButton}"
              MinWidth="120" Padding="16,8" Click="Add_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</UserControl>
