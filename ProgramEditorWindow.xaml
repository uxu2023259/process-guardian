<Window x:Class="ProcessGuardian.ProgramEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="程序设置" Width="650" Height="630" MinWidth="580" MinHeight="580"
        WindowStartupLocation="CenterOwner" Background="#F4F4F4" FontFamily="Segoe UI, Microsoft YaHei UI">
  <Window.Resources>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#333333"/><Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,7"/>
    </Style>
    <Style x:Key="FieldBox" TargetType="TextBox">
      <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#111111"/>
      <Setter Property="BorderBrush" Value="#DDDDDD"/><Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="12,10"/><Setter Property="FontSize" Value="13"/>
      <Setter Property="Margin" Value="0,0,0,17"/>
    </Style>
  </Window.Resources>
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock x:Name="Heading" Text="添加守护程序" FontSize="25" FontWeight="Bold" Foreground="#111111"/>
      <TextBlock Text="配置启动方式与守护行为" FontSize="13" Foreground="#777777" Margin="0,7,0,24"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <TextBlock Text="显示名称" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="NameBox" Style="{StaticResource FieldBox}"/>

        <TextBlock Text="程序文件" Style="{StaticResource FieldLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="PathBox" Style="{StaticResource FieldBox}" Margin="0,0,9,0"/>
          <Button Grid.Column="1" Content="选择文件" Style="{StaticResource QuietButton}" Click="BrowseExecutable_Click"/>
        </Grid>

        <TextBlock Text="启动参数" Style="{StaticResource FieldLabel}"/>
        <TextBox x:Name="ArgumentsBox" Style="{StaticResource FieldBox}"/>
        <TextBlock Text="示例：--profile &quot;我的配置&quot;" FontSize="11" Foreground="#888888" Margin="0,-4,0,15"/>

        <TextBlock Text="工作目录（可留空，默认使用程序所在目录）" Style="{StaticResource FieldLabel}"/>
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBox x:Name="WorkingDirectoryBox" Style="{StaticResource FieldBox}" Margin="0,0,9,0"/>
          <Button Grid.Column="1" Content="选择目录" Style="{StaticResource QuietButton}" Click="BrowseDirectory_Click"/>
        </Grid>

        <CheckBox x:Name="EnabledBox" Content="保存后立即启动并持续守护" IsChecked="True"
                  Foreground="#222222" FontSize="13" FontWeight="SemiBold" Margin="0,20,0,10"/>
      </StackPanel>
    </ScrollViewer>
    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
      <Button Content="取消" Style="{StaticResource QuietButton}" MinWidth="90" Margin="0,0,10,0" IsCancel="True"/>
      <Button Content="保存设置" Style="{StaticResource PrimaryButton}" MinWidth="120" Click="Save_Click" IsDefault="True"/>
    </StackPanel>
  </Grid>
</Window>
