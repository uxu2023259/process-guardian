<UserControl x:Class="ProcessGuardian.Controls.ProgressRing"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="20" Height="20" IsHitTestVisible="False">
  <UserControl.Resources>
    <Storyboard x:Key="SpinStoryboard" RepeatBehavior="Forever">
      <DoubleAnimation Storyboard.TargetName="RingRotation" Storyboard.TargetProperty="Angle"
                       From="0" To="360" Duration="0:0:1"/>
    </Storyboard>
  </UserControl.Resources>
  <Grid RenderTransformOrigin="0.5,0.5">
    <Grid.RenderTransform>
      <RotateTransform x:Name="RingRotation" Angle="0"/>
    </Grid.RenderTransform>
    <Canvas Width="20" Height="20">
      <Ellipse Width="4" Height="4" Canvas.Left="8" Canvas.Top="0" Fill="#0078D4" Opacity="1"/>
      <Ellipse Width="4" Height="4" Canvas.Left="13.7" Canvas.Top="2.3" Fill="#0078D4" Opacity="0.88"/>
      <Ellipse Width="4" Height="4" Canvas.Left="16" Canvas.Top="8" Fill="#0078D4" Opacity="0.76"/>
      <Ellipse Width="4" Height="4" Canvas.Left="13.7" Canvas.Top="13.7" Fill="#0078D4" Opacity="0.64"/>
      <Ellipse Width="4" Height="4" Canvas.Left="8" Canvas.Top="16" Fill="#0078D4" Opacity="0.52"/>
      <Ellipse Width="4" Height="4" Canvas.Left="2.3" Canvas.Top="13.7" Fill="#0078D4" Opacity="0.4"/>
      <Ellipse Width="4" Height="4" Canvas.Left="0" Canvas.Top="8" Fill="#0078D4" Opacity="0.3"/>
      <Ellipse Width="4" Height="4" Canvas.Left="2.3" Canvas.Top="2.3" Fill="#0078D4" Opacity="0.2"/>
    </Canvas>
  </Grid>
</UserControl>
