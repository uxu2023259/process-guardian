<UserControl x:Class="ProcessGuardian.Controls.ProcessTargetOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             IsHitTestVisible="False" UseLayoutRounding="True" SnapsToDevicePixels="True">
  <Grid Background="Transparent" ClipToBounds="True">
    <Border BorderThickness="2" IsHitTestVisible="False">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="Visibility" Value="Collapsed"/>
          <Setter Property="BorderBrush" Value="#0078D4"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding State.ShowHighlight, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter Property="Visibility" Value="Visible"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding State.IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter Property="BorderBrush" Value="#A4262C"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
    </Border>

    <Border x:Name="InfoPanel" HorizontalAlignment="Left" VerticalAlignment="Top"
            Margin="8" Padding="11,9" MaxWidth="460" Background="#F7FFFFFF"
            BorderBrush="#0078D4" BorderThickness="1">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="#0078D4"/>
          <Style.Triggers>
            <DataTrigger Binding="{Binding State.IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
              <Setter Property="BorderBrush" Value="#A4262C"/>
            </DataTrigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <StackPanel>
        <DockPanel LastChildFill="True">
          <Border DockPanel.Dock="Right" Background="#E5F1FB" Padding="6,2" Margin="8,0,0,0">
            <TextBlock Text="{Binding State.ProcessId, RelativeSource={RelativeSource AncestorType=UserControl}, StringFormat='PID {0}'}"
                       FontSize="10" FontWeight="SemiBold" Foreground="#005A9E"/>
          </Border>
          <TextBlock Text="{Binding State.WindowTitle, RelativeSource={RelativeSource AncestorType=UserControl}, TargetNullValue=选择目标应用}"
                     FontSize="12" FontWeight="SemiBold" Foreground="#1F1F1F"
                     TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
        </DockPanel>

        <TextBlock Text="{Binding State.ProcessName, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="10" Foreground="#323130" Margin="0,5,0,0"
                   TextTrimming="CharacterEllipsis"/>
        <TextBlock Text="{Binding State.ExecutablePath, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="10" Foreground="#605E5C" Margin="0,3,0,0"
                   TextWrapping="Wrap" MaxWidth="430"/>
        <TextBlock Text="{Binding State.StatusMessage, RelativeSource={RelativeSource AncestorType=UserControl}}"
                   FontSize="10" Foreground="#605E5C" Margin="0,5,0,0"
                   TextWrapping="Wrap">
          <TextBlock.Style>
            <Style TargetType="TextBlock">
              <Style.Triggers>
                <DataTrigger Binding="{Binding State.IsError, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                  <Setter Property="Foreground" Value="#A4262C"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State.IsLoading, RelativeSource={RelativeSource AncestorType=UserControl}}" Value="True">
                  <Setter Property="Foreground" Value="#005A9E"/>
                </DataTrigger>
              </Style.Triggers>
            </Style>
          </TextBlock.Style>
        </TextBlock>
      </StackPanel>
    </Border>

    <Canvas IsHitTestVisible="False" ClipToBounds="True">
      <TextBlock x:Name="PointerMark" Text="⌖" FontFamily="Segoe UI Symbol" FontSize="25"
                 FontWeight="SemiBold" Foreground="#0078D4" Width="30" Height="30"
                 TextAlignment="Center" Visibility="Collapsed"/>
    </Canvas>
  </Grid>
</UserControl>
